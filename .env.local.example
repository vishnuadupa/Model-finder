# ── AI APIs ──────────────────────────────────────────────────────────────
# Required for Gemini speed advisor
GEMINI_API_KEY=your_gemini_api_key_here
# Get free key at: https://aistudio.google.com/apikey

# Required for Claude summary (add after launch)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Vercel KV (for caching AI responses) ─────────────────────────────────
# Get from Vercel Dashboard → Storage → KV
KV_REST_API_URL=your_kv_url_here
KV_REST_API_TOKEN=your_kv_token_here

# ── HuggingFace (for daily model scraper) ────────────────────────────────
# Get read-only token at: https://huggingface.co/settings/tokens
HF_TOKEN=your_hf_token_here

# ── Discord (optional new-model alerts) ──────────────────────────────────
# Discord → Channel Settings → Integrations → Webhooks
DISCORD_WEBHOOK=your_discord_webhook_url

# ── AdSense (add after approval) ─────────────────────────────────────────
NEXT_PUBLIC_ADSENSE=ca-pub-XXXXXXXXXXXXXXXX
